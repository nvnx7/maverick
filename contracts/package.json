{
  "name": "@repo/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "fork:local": "anvil --fork-url ${RPC_ARC_TESTNET:-https://rpc.testnet.arc.network}",
    "deploy:local": "forge script scripts/Deploy.s.sol --sig \"run(string)\" \"local\" --rpc-url http://127.0.0.1:8545 --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 --broadcast",
    "deploy:arc": "forge script scripts/Deploy.s.sol --sig \"run(string)\" \"arcTestnet\" --rpc-url $RPC_ARC_TESTNET --private-key $DEPLOYER_PRIVATE_KEY --broadcast"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "erc-8183/base-contracts": "github:erc-8183/base-contracts#142e669c1fd318486a4628395b629f033654dd06",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2"
  }
}
