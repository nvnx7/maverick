# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist

# Contracts (Foundry)
contracts/cache/
contracts/cache_hardhat/
contracts/broadcast/

# hardhat-viem writes artifacts.d.ts here on every `hardhat compile`, even
# though nothing actually compiles (see contracts/hardhat.config.ts). The
# directory itself is tracked via contracts/artifacts/.gitkeep so that write
# has somewhere to land.
contracts/artifacts/*
!contracts/artifacts/.gitkeep

# Local-chain deployment records are throwaway; real ones are worth committing.
contracts/deployments/local.json

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
